# Backend server port
PORT=5000

# MongoDB connection string (do not commit real credentials)
MONGODB_URI=mongodb://localhost:27017/mfd_system

# ML prediction service base URL
ML_SERVICE_URL=http://localhost:8000

# Allowed frontend origin(s) for CORS, comma-separated
CORS_ORIGIN=http://localhost:5173

# Default machine identifier used when ESP32 does not send one
DEFAULT_MACHINE_ID=MOTOR-01

# Seconds of silence before a machine is considered DISCONNECTED
DEVICE_OFFLINE_THRESHOLD_SECONDS=15

# Timeout (ms) for calls to the ML service
ML_SERVICE_TIMEOUT_MS=5000
